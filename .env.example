# Groq Cloud API (optional — cockpit falls back to deterministic SQL + template synthesis if unset)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Supabase PostgreSQL (optional — local SQLite veloxa.db is used automatically as mirror/fallback)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Path to local Veloxa Hackathon Release Packs directory (for running ingestion on new drops)
VELOXA_DATA_DIR=
